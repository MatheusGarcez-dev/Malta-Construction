{
  "version": 2,
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php?page=home" },
    { "source": "/about", "destination": "/api/index.php?page=about" },
    { "source": "/contact", "destination": "/api/index.php?page=contact" },
    { "source": "/residential", "destination": "/api/index.php?page=residential" },
    { "source": "/commercial", "destination": "/api/index.php?page=commercial" },
    { "source": "/renovation", "destination": "/api/index.php?page=renovation" },
    { "source": "/finish-carpentry", "destination": "/api/index.php?page=finish-carpentry" },
    { "source": "/custom-closets", "destination": "/api/index.php?page=custom-closets" },
    { "source": "/stair-renovation", "destination": "/api/index.php?page=stair-renovation" },
    { "source": "/trim-work", "destination": "/api/index.php?page=trim-work" },
    { "source": "/cabinet-installation", "destination": "/api/index.php?page=cabinet-installation" },
    { "source": "/flooring", "destination": "/api/index.php?page=flooring" },
    { "source": "/carpentry", "destination": "/api/index.php?page=carpentry" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
